{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cjs:skills",
  "title": "Skills File",
  "description": "Authored skills. Each entry maps to a SkillEntry in src/content/types.ts.",
  "allOf": [{ "$ref": "_envelope.schema.json" }],
  "type": "object",
  "properties": {
    "_file": {
      "properties": { "format": { "enum": ["cjs-skills", "cjs-collection"] } }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/SkillEntry" }
    }
  },
  "definitions": {
    "SkillEntry": {
      "type": "object",
      "required": ["id", "name", "power", "ap", "mp"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "power": { "type": "number" },
        "ap": { "type": "number", "minimum": 0 },
        "mp": { "type": "number", "minimum": 0 },
        "spCost": { "type": "number", "minimum": 0 },
        "cooldown": { "type": "number", "minimum": 0 },
        "damageType": { "type": ["string", "null"] },
        "element": { "type": ["string", "null"] },
        "scalingStat": { "type": "string", "enum": ["S", "P", "E", "C", "I", "A", "L"] },
        "range": { "type": "number", "minimum": 0 },
        "aoe": { "type": ["string", "null"] },
        "aoeSize": { "type": "number", "minimum": 0 },
        "qte": { "type": ["string", "null"] },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContentEffect" }
        },
        "levelScaling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "powerPerLevel": { "type": "number" },
            "maxLevel": { "type": "number", "minimum": 1 },
            "perLevel": { "type": "number" },
            "perks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["atLevel"],
                "additionalProperties": true,
                "properties": {
                  "atLevel": { "type": "number", "minimum": 1 },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "isUltimate": { "type": "boolean" },
        "ultimateCost": { "type": "number", "minimum": 0 },
        "requiredWeaponTypes": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ContentEffect": {
      "description": "Either a master-effects reference ({effectId, overrides}) or an inline legacy effect ({type, ...}). Both are accepted.",
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": ["effectId"],
          "properties": {
            "effectId": { "type": "string", "minLength": 1 },
            "overrides": { "type": "object" }
          }
        },
        {
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "target": { "type": "string" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "stacks": { "type": "number" },
            "duration": { "type": "number" },
            "amount": { "type": "number" }
          }
        }
      ]
    }
  }
}
