            { "to": "hunter_cache", "label": "Check the hunter cache" },
            { "to": "campfire_pine", "label": "Fall back to a pine campfire" },
            { "to": "old_stardust_vein", "label": "Trace the odd blue glimmer", "dangerChange": 1 },
            { "to": "frostwood_edge", "label": "Return to the edge" }
          ]
        },
        {
          "id": "frozen_creek",
          "title": "Frozen Creek",
          "kind": "trap",
          "x": 305,
          "y": 330,
          "tags": ["water", "cold", "dangerous"],
          "trap": {
            "title": "Weak Ice",
            "check": {
              "type": "stat",
              "stat": "A",
              "dc": 12,
              "success": [{ "op": "log", "text": "Quick footing keeps everyone dry." }],
              "fail": [
                { "op": "damage_party", "amount": 5 },
                { "op": "add_status", "target": "party_random", "status": "cold", "duration": "scenario" }
