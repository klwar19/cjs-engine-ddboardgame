          "exits": [
            { "to": "wolf_tracks", "label": "Return to wolf tracks" },
            { "to": "hunter_cache", "label": "Check the hunter cache" },
            { "to": "old_shrine", "label": "Climb toward the old shrine" },
            { "to": "old_stardust_vein", "label": "Inspect the blue glimmer", "dangerChange": 1 }
          ]
        },
        {
          "id": "wolf_den",
          "title": "Wolf Den",
