          "exits": [
            {
              "to": "wolf_tracks",
              "label": "Follow wolf tracks",
              "dangerChange": 1,
              "onTravel": [
                { "op": "log", "text": "The party follows fresh tracks under heavy frost." }
              ]
            },
            {
              "to": "frozen_creek",
              "label": "Take the creek route",
              "check": {
                "type": "stat",
                "stat": "P",
                "dc": 10,
                "success": [{ "op": "log", "text": "The party spots a safe path over the creek." }],
                "fail": [{ "op": "danger", "amount": 1 }]
              }
            },
            {
              "to": "broken_sled",
              "label": "Inspect the broken sled",
              "onTravel": [
                { "op": "log", "text": "The party detours toward a half-buried sled trail." }
              ]
            }
          ]
        },
        {
          "id": "wolf_tracks",
          "title": "Wolf Tracks",
          "kind": "event_battle",
          "x": 320,
          "y": 205,
          "tags": ["forest", "predator"],
          "onEnter": [
            { "op": "update_quest_progress", "questId": "quest_clear_wolf_pack", "objectiveId": "read_tracks", "amount": 1 },
            { "op": "update_quest_progress", "questId": "quest_ironhand_pelt_wraps", "objectiveId": "find_pelt_marks", "amount": 1 },
            { "op": "log", "text": "Quest clue: the tracks split toward a den and a ridge trail." }
