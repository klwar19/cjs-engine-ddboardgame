{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tools/visual-regression/cases.tsx",
    "js/campaign/campaign-ops.js",
    "js/campaign/campaign-world-events.js",
    "js/campaign/guild-trivia.js",
    "js/campaign/pocket-haven-facilities.js",
    "js/grid/grid-renderer.js",
    "js/minigames/cooking-minigame.js",
    "js/minigames/fishing-minigame.js",
    "js/services/data-hot-reload.js",
    "js/services/dev-console.js",
    "js/ui/touch-gestures.js"
  ]
}
